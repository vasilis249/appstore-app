# Copy to .env and fill in. Never commit the real .env.
#
# Public (safe to ship to the browser — anon key is protected by RLS):
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"
SUPABASE_PROJECT_ID="YOUR_PROJECT"

# SERVER-ONLY secrets — must NOT have a VITE_ prefix, must never reach the client.
# Set these in your host's environment (Cloudflare/Lovable), not in a committed file.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
DEEPL_API_KEY="YOUR_DEEPL_KEY"
GOOGLE_MAPS_API_KEY="YOUR_REFERRER_RESTRICTED_MAPS_KEY"

# iOS shell (Capacitor) — read by capacitor.config.ts
CAP_SERVER_URL="https://courtsie.YOUR_SUBDOMAIN.workers.dev"
# Must match the Bundle Identifier registered in your Apple Developer account
CAP_APP_ID="gr.innera.courtsie"
