  "name": "courtsie",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://gqmzxxygegmlifeewbzy.supabase.co",
    "SUPABASE_PROJECT_ID": "gqmzxxygegmlifeewbzy",
  },
}
